    }

.panel-subtitle {
        color: #bb9b76;
        font-size: 12px;
        margin: 5px 0 12px 0;
    }

.warning {
        background: #2d1d0e;
        border: 1px solid #a87308;
        border-left: 5px solid #f1a400;
        border-radius: 12px;
        color: #ead7bd;
        font-size: 13px;
        margin: 20px 0;
        padding: 13px 16px;
    }

[data-testid="stDataFrame"] {
        border: 1px solid #50351e;
        border-radius: 10px;
