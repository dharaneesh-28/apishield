import sqlite3
from pathlib import Path

import pandas as pd
import plotly.express as px
import streamlit as st

DB_PATH = Path(__file__).resolve().parent / "apishield.db"

st.set_page_config(
    page_title="APIShield Security Console",
    page_icon="🛡️",
    layout="wide",
    initial_sidebar_state="expanded",
)

st.markdown(
    """
    <style>
    .stApp {
        background: #120d09;
        color: #f4e8d7;
    }

[data-testid="stSidebar"] {
        background: #1b110b;
        border-right: 1px solid #50351e;
    }

[data-testid="stSidebar"] > div:first-child {
        padding: 1.5rem 1rem;
    }

.brand {
        padding: 10px 4px 28px 4px;
        border-bottom: 1px solid #50351e;
        margin-bottom: 25px;
    }

.brand-title {
        color: #f7ead8;
        font-size: 25px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

.brand-subtitle {
        color: #df971e;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-top: 5px;
    }

.nav-section {
        color: #a98967;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        margin: 22px 4px 10px 4px;
        text-transform: uppercase;
    }

.nav-item {
        color: #d9c2a5;
        padding: 11px 12px;
        border-radius: 8px;
        margin: 4px 0;
        font-size: 14px;
    }

.nav-active {
        background: #4b2914;
        color: #ffd487;
        border-left: 3px solid #e3a116;
        font-weight: 700;
    }

.side-footer {
        color: #977b5e;
        font-size: 11px;
        line-height: 1.7;
        border-top: 1px solid #50351e;
        padding-top: 18px;
        margin-top: 80px;
    }

.topbar {
        background: #24170f;
        border: 1px solid #50351e;
        border-radius: 14px;
        padding: 20px 24px;
        margin-bottom: 24px;
    }

.topbar-title {
        color: #f7ead8;
        font-size: 27px;
        font-weight: 800;
    }

.topbar-subtitle {
        color: #b99875;
        font-size: 13px;
        margin-top: 5px;
    }

.status {
        display: inline-block;
        background: #163421;
        border: 1px solid #27663b;
        border-radius: 20px;
        color: #6be091;
        font-size: 12px;
        font-weight: 700;
        margin-top: 16px;
        padding: 6px 12px;
    }

.metric-card {
        background: #24170f;
        border: 1px solid #50351e;
        border-radius: 14px;
        min-height: 145px;
        padding: 20px;
    }

.metric-label {
        color: #bb9b76;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.7px;
    }

.metric-value {
        color: #f7ead8;
        font-size: 35px;
        font-weight: 800;
        margin-top: 14px;
    }

.metric-note {
        color: #df971e;
